# ============================================================
# LexiAssist 2.0 — environment variables
# Copy to ".env" for local dev, and set the same keys in your Vercel project.
# Variables prefixed VITE_ are BUILD-TIME and bundled into the client.
# Variables WITHOUT the VITE_ prefix are SERVER-ONLY (never exposed).
# ============================================================

# --- Secure server-key mode (recommended for shared/public deployments) ---
# Server-side ONLY. Used by the /api/gemini Edge Function. NEVER prefix with VITE_.
GEMINI_API_KEY=

# Build-time flag. When "true", the client routes all AI calls through
# /api/gemini (so the key above stays on the server). Leave unset/empty for
# bring-your-own-key mode where each user enters their own key in the UI.
VITE_USE_PROXY=true

# Server-side ONLY. Best-effort per-IP rate limit for the proxy (requests per
# minute; 0 disables). Protects your shared key from abuse. Default 20.
RATE_LIMIT_PER_MIN=20

# --- Required when VITE_USE_PROXY=true: Supabase auth + cloud persistence ---
# Both values are safe to expose to the browser (the anon key is protected by
# Row Level Security). The Gemini proxy validates the caller's Supabase JWT,
# so public/shared deployments must set both values before enabling the proxy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
